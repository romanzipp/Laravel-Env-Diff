{
    "name": "romanzipp/laravel-env-diff",
    "description": "Create a visual Diff of .env and .env.example files",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "romanzipp",
            "email": "ich@ich.wtf",
            "homepage": "https://ich.wtf"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/console": "^7.2|^8.0",
        "vlucas/phpdotenv": "^5.6",
        "wujunze/php-cli-color": "^2.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "illuminate/testing": "^12.0|^13.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "romanzipp/php-cs-fixer-config": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "romanzipp\\EnvDiff\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "romanzipp\\EnvDiff\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "romanzipp\\EnvDiff\\Providers\\EnvDiffProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
